# ══════════════════════════════════════════════════════════════
#  StockIQ — variables d'environnement (docker-compose)
#  Copiez ce fichier en « .env » puis adaptez les valeurs.
#      cp .env.example .env
#  Le fichier .env est ignoré par git (ne jamais committer de secrets).
# ══════════════════════════════════════════════════════════════

# ── Base de données MySQL ─────────────────────────────────────
DB_NAME=gestion_stock
DB_PASSWORD=changeme_db_password

# ── Sécurité JWT (minimum 32 caractères) ──────────────────────
JWT_SECRET=change_me_to_a_random_32_chars_minimum_secret

# ── Compte administrateur initial (créé au 1er démarrage) ─────
DEFAULT_ADMIN_LOGIN=admin
DEFAULT_ADMIN_PASSWORD=changeme_admin_password

# ── Tag d'image (laissé à « local » hors CI) ──────────────────
IMAGE_TAG=local
